{
"name": "sentinel-logs-agent",
  "version": "1.0.4",
  "description": "Lightweight cross-platform log collection agent for Sentinel-Logs SIEM - Works on Linux, Windows, macOS",
  "type": "module",
  "main": "index.js",
  "bin": {
    "sentinel-agent": "./index.js",
    "siem-agent": "./index.js",
    "siem-agent-diagnose": "./diagnose.js"
  },
  "scripts": {
    "start": "node index.js",
    "test": "mocha test/**/*.test.js --timeout 5000",
    "test:watch": "mocha test/**/*.test.js --watch"
  },
  "files": [
    "index.js",
    "diagnose.js",
    "src/",
    "config.example.json",
    "README.md"
  ],
  "keywords": [
    "siem",
    "sentinel-logs",
    "log-agent",
    "log-collection",
    "security-monitoring",
    "cybersecurity",
    "threat-detection",
    "log-forwarding",
    "offline-siem",
    "air-gapped",
    "cross-platform",
    "linux",
    "windows",
    "macos",
    "kali-linux",
    "ubuntu",
    "centos"
  ],
  "author": "Tanish Jain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/05tanish/sentinel-logs.git",
    "directory": "Agent"
  },
  "homepage": "https://github.com/05tanish/sentinel-logs#readme",
  "bugs": {
    "url": "https://github.com/05tanish/sentinel-logs/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "linux",
    "darwin",
    "win32"
  ],
  "dependencies": {
    "axios": "^1.15.0",
    "chokidar": "^3.6.0",
    "inquirer": "^13.4.2"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.10",
    "sinon": "^17.0.1"
  }
}
