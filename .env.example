# Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=siem
DATABASE_URL=postgresql://your_db_user:your_db_password@postgres:5432/siem

# Database Pool Settings
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000
DB_ACQUIRE_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=60000

# Loki Configuration
LOKI_URL=http://loki:3100

# API Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://your-server-ip:4000
SYSLOG_PORT=514

# Security Settings
AGENT_API_KEY=your-secure-agent-api-key-32-chars-minimum

# Rate Limiting & Security
JSON_LIMIT=10kb
URL_ENCODED_LIMIT=10kb
TRUST_PROXY_HOPS=1

# Alert Configuration
ALERT_THRESHOLD=3
TIME_WINDOW_MINUTES=5

# Retention Policy
LOG_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=365
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password
