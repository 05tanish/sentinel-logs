# Database Configuration
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=siem
DATABASE_URL=postgresql://your_db_user:your_db_password@postgres:5432/siem

# Loki Configuration
LOKI_URL=http://loki:3100

# API Configuration
PORT=4000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here
CORS_ORIGIN=http://your-server-ip:4000
SYSLOG_PORT=514

# Alert Configuration
ALERT_THRESHOLD=3
TIME_WINDOW_MINUTES=5

# Retention Policy
LOG_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=365
GF_SECURITY_ADMIN_PASSWORD=your_grafana_password
